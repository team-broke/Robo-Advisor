# 원본 데이터 디렉터리 (상대 경로는 실행 디렉터리 기준)
DATA_RAW_DIR=data/raw
# 가공 데이터 디렉터리
DATA_PROCESSED_DIR=data/processed
# 벡터 저장소 디렉터리
DATA_VECTORSTORE_DIR=data/vectorstore
# 실험 및 평가 산출물 디렉터리
ARTIFACTS_DIR=artifacts
# 학습 모델 디렉터리
MODELS_DIR=models
# 거래 수수료 비율 (0 이상 1 미만, 기본 0.015%)
COMMISSION_RATE=0.00015
# 거래 슬리피지 비율 (0 이상 1 미만, 기본 0.05%)
SLIPPAGE_RATE=0.0005
# Safe-Guard 최대 낙폭 한도 (0 초과 1 이하, 기본 15%)
SAFEGUARD_MDD_LIMIT=0.15
# API 서버 바인딩 주소
API_HOST=127.0.0.1
# API 서버 포트 (1~65535)
API_PORT=8000
# 대시보드가 호출할 HTTP(S) API 기본 URL
API_BASE_URL=http://localhost:8000
# DART API 키 (선택, 미설정 시에도 기동)
DART_API_KEY=
# LLM API 키 (선택, 미설정 시에도 기동)
LLM_API_KEY=
# LLM 모델명 (선택, 기본값 없음)
LLM_MODEL=
# LLM 프로바이더 (선택, 기본값 없음)
LLM_PROVIDER=
